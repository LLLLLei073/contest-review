{
  "name": "contest-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "vue-tsc --noEmit",
    "check:cf": "tsx scripts/check-codeforces.ts",
    "format": "prettier --write src server shared scripts tests *.ts *.json index.html README.md",
    "build:pages": "vue-tsc --noEmit && vite build --mode pages && node scripts/build-offline.mjs",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 4173",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.1.0",
    "sql.js": "^1.14.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.0"
  }
}
